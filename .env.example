# Postgres connection string (Neon or Supabase via the Vercel Marketplace, or local)
DATABASE_URL=postgres://user:password@localhost:5432/ogserc_hub

# Long random string used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# First Commission administrator, created by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=OGSERC Administrator
